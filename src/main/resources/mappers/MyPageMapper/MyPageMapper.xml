<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.kosmo.mypage.mapper.MyPageMapper">

    <!-- 결제 성공한 강의 목록 조회 -->
    <!-- 결제 성공한 강의 목록 조회 (유저 닉네임 포함) -->
    <select id="paycourses" resultType="com.kosmo.mypage.dto.PayDTO">
        SELECT
        p.course_id,
        c.title,
        c.image,
        u.nickname   <!-- 강사의 유저 닉네임 추가 -->
        FROM
        payments p
        JOIN
        courses c ON p.course_id = c.course_id
        JOIN
        users u ON c.instructor_id = u.id  <!-- 강사 테이블과 조인 -->
        WHERE
        p.user_id = #{userId}  <!-- 실제 사용자 ID를 파라미터로 전달 -->
        AND p.payment_status = 'SUCCESS'
    </select>

</mapper>
