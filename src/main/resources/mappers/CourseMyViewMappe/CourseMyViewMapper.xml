<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.kosmo.coursemyview.mapper.CourseMyViewMapper">

    <!-- 강의 상세 정보 조회 -->
    <select id="CourseMyView" resultType="com.kosmo.coursemyview.dto.CourseMyViewDTO">
        SELECT title, url, materials, description, summary
        FROM courses
        WHERE course_id = #{courseId}
    </select>

</mapper>
